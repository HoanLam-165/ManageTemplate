    },
    {
        orientation: "portrait",
        size: "a4",
        elements: [
            { type: "text", x: 20, y: 20, text: "Page 3: Many Elements", fontSize: 16 },
            ...Array.from({length: 20}).map((_, i) => ({
                type: "rect",
                x: 10 + (i % 5) * 30,
                y: 50 + Math.floor(i / 5) * 30,
                width: 20,
                height: 20,
                color: i % 2 === 0 ? "#000000" : "#CCCCCC",
                zIndex: i
