        <title id="archify-diagram-title">Product Analytics Data Flow</title>
        <desc id="archify-diagram-description">A data-flow diagram generated by Archify.</desc>
        <!-- Definitions -->
        <defs>
          <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
            <polygon points="0 0, 10 3.5, 0 7" class="m-default" />
