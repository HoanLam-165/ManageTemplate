import numpy as np
from PIL import Image, ImageDraw, ImageFont
from augraphy import AugraphyPipeline, LightingGradient, NoiseTexturize, ShadowCast
from faker import Faker

fake = Faker('vi_VN')

# --- REPRODUCIBILITY ---
SEED = 42
