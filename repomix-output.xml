  assert.match(html, /!clone\.hasAttribute\('data-route-active'\)/);
  assert.doesNotMatch(canonicalSvg(html), /data-route-|route-probe-flow/);
});

process.on('exit', () => fs.rmSync(tmp, { recursive: true, force: true }));
